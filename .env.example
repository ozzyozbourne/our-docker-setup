# Copy to .env and fill in. .env is never committed.

# Postgres (any long random strings)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
RIVET_DB_PASSWORD=

# Rivet engine admin token (any long random string)
RIVET_ADMIN_TOKEN=

# Bearer token for Alloy's OTLP receiver (any long random string)
ALLOY_OTLP_TOKEN=

# Public address of the app (the Funnel URL on the VM)
PUBLIC_URL=http://localhost:3000

# Model key for M1, until BYOK lands in M3
OPENROUTER_API_KEY=

# Daily backups to R2 (only needed with --profile backup)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Turn on the daily backup once the R2 keys are set
# COMPOSE_PROFILES=backup

# Set by the deploy workflow on the VM; leave unset locally
# APP_IMAGE=
# BACKUP_IMAGE=
# IMAGE_TAG=
