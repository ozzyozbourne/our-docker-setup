# Copy to .env and fill in. .env is never committed.

# Postgres (any long random strings)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
RIVET_DB_PASSWORD=

# pgAdmin login at localhost:5050 (the email is only a login name)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# Rivet engine admin token (any long random string)
RIVET_ADMIN_TOKEN=

# Bearer token for Alloy's OTLP receiver (any long random string)
ALLOY_OTLP_TOKEN=

# Grafana Cloud → your stack → OpenTelemetry → Configure
GRAFANA_OTLP_ENDPOINT=
GRAFANA_INSTANCE_ID=
GRAFANA_API_TOKEN=

# Honeycomb → Environment → API Keys → Ingest key (use the full secret)
# EU accounts: https://api.eu1.honeycomb.io
HONEYCOMB_ENDPOINT=https://api.honeycomb.io
HONEYCOMB_API_KEY=

# Public address of the app (the Funnel URL on the VM)
PUBLIC_URL=http://localhost:3000

# Model key for M1, until BYOK lands in M3
OPENROUTER_API_KEY=

# Set by the deploy workflow on the VM; leave unset locally
# APP_IMAGE=
# IMAGE_TAG=
