// OTLP in on 4318 (bearer token required; Funnel exposes it on 8443 for executors).
otelcol.auth.bearer "executors" {
  token = sys.env("ALLOY_OTLP_TOKEN")
}

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
    auth     = otelcol.auth.bearer.executors.handler
  }
  output {
    logs    = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    logs    = [otelcol.exporter.otlphttp.grafana.input]
    metrics = [otelcol.exporter.otlphttp.grafana.input]
    traces  = [otelcol.exporter.otlphttp.grafana.input, otelcol.exporter.otlphttp.honeycomb.input]
  }
}

// Grafana Cloud: logs to Loki, metrics to Prometheus, traces to Tempo.
otelcol.auth.basic "grafana" {
  username = sys.env("GRAFANA_INSTANCE_ID")
  password = sys.env("GRAFANA_API_TOKEN")
}

otelcol.exporter.otlphttp "grafana" {
  client {
    endpoint = sys.env("GRAFANA_OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.grafana.handler
  }
}

// Honeycomb: traces only.
otelcol.exporter.otlphttp "honeycomb" {
  client {
    endpoint = sys.env("HONEYCOMB_ENDPOINT")
    headers  = {
      "x-honeycomb-team" = sys.env("HONEYCOMB_API_KEY"),
    }
  }
}
